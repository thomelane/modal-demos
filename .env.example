# Copy to .env and fill in. The endpoint demos require it; the Sandbox demos
# run without it, using credentials from the active Modal profile.

# Modal proxy auth token for the endpoint demos, from a workspace proxy-auth key.
MODAL_KEY=wk-xxxxxxxxxxxxxxxxxxxxxx
MODAL_SECRET=ws-xxxxxxxxxxxxxxxxxxxxxx

# One base URL and model per endpoint. `make load-shared` reads the SHARED_ pair,
# `load-dedicated` the DEDICATED_ pair, `load-custom` the CUSTOM_ pair.
SHARED_BASE_URL=https://your-workspace--shared-endpoint.modal.run
SHARED_MODEL=Qwen/Qwen3.6-27B-FP8
DEDICATED_BASE_URL=https://your-workspace--dedicated-endpoint.modal.run
DEDICATED_MODEL=Qwen/Qwen3.6-27B-FP8
CUSTOM_BASE_URL=https://your-workspace--custom-endpoint.modal.run
CUSTOM_MODEL=Qwen/Qwen3.6-27B-FP8

# Modal Volume holding the model weights for `make deploy-server`.
ENDPOINT_VOLUME_NAME=flash-endpoint-model

# Optional: Modal environment to target. Defaults to the active profile's.
# MODAL_ENVIRONMENT=main

# Optional: force the Sandbox backend. Unset uses the SDK default, which is
# V2 as of modal 0.11.0.
# MODAL_SANDBOX_V2=1
